#!/usr/bin/env bash
# Quality gates do plugin: typecheck, testes e validate. Rode na raiz do repo antes do push.
# O .d.ts do engine não vai no git (.claude-plugin/types/ é gerado); sem ele, copia o da
# skill plugin-authoring que o Claude Code extrai em bundled-skills, a versão mais nova.
set -euo pipefail
cd "$(dirname "$0")/.."
dts=.claude-plugin/types/claude-code/index.d.ts
if [ ! -f "$dts" ]; then
  src=$(ls -d "${TMPDIR:-/tmp}"/../claude-*/bundled-skills/*/*/plugin-authoring/types/claude-code.d.ts /private/tmp/claude-*/bundled-skills/*/*/plugin-authoring/types/claude-code.d.ts 2>/dev/null | sort -V | tail -1 || true)
  [ -n "$src" ] || { echo "sem tipos do engine: abra uma sessão do Claude Code e rode /plugin-authoring uma vez" >&2; exit 1; }
  mkdir -p "$(dirname "$dts")" && cp "$src" "$dts"
  [ -f .claude-plugin/types/.gitignore ] || printf '*\n' > .claude-plugin/types/.gitignore
fi
npx -y -p typescript@5.6.3 tsc -p .
claude plugin test .
claude plugin validate .
