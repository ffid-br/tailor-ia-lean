#!/usr/bin/env bash
# Gera o branch `diretorio`: a edição que o diretório da Anthropic aceita.
# O diretório recusa hook de comando e mod de organização que não é Verified, então este
# branch leva só skills e agentes. O `main` continua completo (marketplace do GitHub).
# Rode na raiz, com a árvore limpa, depois de cada versão nova; no fim, o push é manual.
set -euo pipefail
cd "$(dirname "$0")/.."

# Função: o script apaga a própria pasta no meio, então o bash precisa tê-lo lido inteiro antes.
main() {
  [ -z "$(git status --porcelain)" ] || { echo "árvore suja: faça commit ou stash antes" >&2; exit 1; }
  local de base v
  de=$(git rev-parse --abbrev-ref HEAD); base=$(git rev-parse --short HEAD)
  v=$(jq -r .version .claude-plugin/plugin.json)

  git checkout -q -B diretorio
  git rm -rq hooks tests types tsconfig.json scripts benchmarks docs

  jq 'del(.types) | .description = "Gaste menos tokens e erre menos no Claude Code. Quatro skills em português: /lean (regras de economia e de raciocínio, com o porquê de cada uma), /orquestrar (o modelo caro planeja, agentes em Haiku e Sonnet executam), /fluxo-dev (do ticket ao PR com quality gates) e /fechar (guarda na memória do projeto o que a sessão aprendeu). Tailor.ia é uma marca da FFID."' \
    .claude-plugin/plugin.json > plugin.tmp && mv plugin.tmp .claude-plugin/plugin.json

  # /fechar chamava um script do plugin; nesta edição lista a pasta direto.
  sed -i.bak 's|^Rode `"${CLAUDE_PLUGIN_ROOT}"/scripts/memoria-status` (ou liste `docs/memoria/` por data).|Liste `docs/memoria/` por data.|' skills/fechar/SKILL.md
  rm skills/fechar/SKILL.md.bak
  ! grep -q 'CLAUDE_PLUGIN_ROOT' skills/fechar/SKILL.md || { echo "skills/fechar ainda cita script do plugin" >&2; exit 1; }

  awk 'NR==2 { print; while ((getline l < "/dev/stdin") > 0) print l; next } { print }' README.md > README.tmp <<'AVISO'
> **Edição do diretório da Anthropic.** Esta edição traz só as skills e os agentes. O diretório
> não aceita hook nem painel de organização que não é Verified, então aqui as regras não entram
> sozinhas no início da sessão e não há `/lean-painel`, `/lean-time` nem trava de recursos.
> Rode `/lean` no começo da sessão, ou cole no `CLAUDE.md` do projeto: "Siga as regras da skill
> tailor-ia-lean:lean". O handoff do `/fechar` também não aparece sozinho: peça "leia o handoff".
> A edição completa instala pelo GitHub: `/plugin marketplace add ffid-br/tailor-ia-lean` e
> `/plugin install tailor-ia-lean@tailor-ia-lean`.

AVISO
  mv README.tmp README.md

  git add -A
  git commit -q -m "diretorio: edição sem hook e sem mod a partir de $base ($v)"
  git checkout -q "$de"
  echo "branch diretorio gerado de $base ($v). Publicar: git push -f origin diretorio"
}
main
