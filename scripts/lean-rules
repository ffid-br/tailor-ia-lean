#!/usr/bin/env bash
# SessionStart: injeta as regras do modo enxuto no contexto. Curto de propósito: ~350 tokens.
# A versão completa, com o porquê de cada regra, está na skill `lean`.
# Mesmo hook no Claude Code e no Codex. O Codex expõe PLUGIN_ROOT e não tem
# CLAUDE_PROJECT_DIR; lá não há subagente em Haiku/Sonnet, as instruções do
# projeto ficam em AGENTS.md e skill se chama com $nome em vez de /nome.
set -uo pipefail

if [ -n "${PLUGIN_ROOT:-}" ] && [ -z "${CLAUDE_PROJECT_DIR:-}" ]; then
  P='$'; INSTR='AGENTS.md'; FIM='/compact ou um chat novo'
  DELEGA='- Faça direto, um arquivo por vez. Com 3+ arquivos, planeje os passos antes (guia em $orquestrar) e valide cada um.'
else
  P='/'; INSTR='CLAUDE.md'; FIM='/compact ou /clear'
  DELEGA='- Investigação que vai tocar 3+ arquivos ("onde", "quem chama", "como funciona"): primeira ação é lançar o agente `batedor` (Haiku) com a pergunta; leia só a tabela que volta. Tarefa de 1 ou 2 arquivos: faça direto. Passo já especificado → `operario` (Sonnet); revisar diff → `revisor` (Sonnet). Fluxo em /orquestrar.
- Tem a resposta? Pare. Não confirme com leitura extra; cada turno a mais relê o contexto inteiro.'
fi

cat <<TXT
# Tailor.ia Lean — ativo nesta sessão
Economia de tokens:
- Resposta curta, direta, sem narrar tool calls nem repetir o que o usuário já sabe. Código antes de prosa.
- Localize antes de ler: grep/find e \`sed -n A,Bp\`; nunca \`cat\` de arquivo grande inteiro. Não releia arquivo que acabou de editar.
$DELEGA
- Chamadas independentes no mesmo bloco. Log ou saída longa: filtre e cite só a linha decisiva.
- Tarefa concluída e assunto mudou: sugira $FIM.
Qualidade de raciocínio:
- Antes de editar: leia $INSTR, docs/memoria/ (se existir) e trace o fluxo real de ponta a ponta. Depois escolha a menor mudança no lugar certo.
- Bug = causa raiz. Liste os callers da função antes de corrigir; um guard no ponto comum vale mais que N guards nos chamadores.
- Reaproveite o que já existe no repo; nada de abstração, config ou dependência nova para caso único.
- Rode os quality gates do repo (lint, typecheck, test) antes de dizer "pronto". Falhou: diga qual e mostre a linha.
- Fim de sessão: ${P}fechar guarda o aprendizado em docs/memoria/, limpa registros vencidos e diz se é $FIM.
Fluxo de entrega: ${P}fluxo-dev (ticket, branch, PR, quality gates, memória).
TXT

# Índice da memória do projeto: docs/memoria/ do repo e fallback ~/.tailor-ia-lean/memoria/<pasta>. Só nome + título.
for dir in "$(git rev-parse --show-toplevel 2>/dev/null)/docs/memoria" "$HOME/.tailor-ia-lean/memoria/$(basename "$PWD")"; do
  [ -d "$dir" ] || continue
  files=("$dir"/*.md); [ -e "${files[0]}" ] || continue
  echo "Memória do projeto (${#files[@]} registros em $dir). Leia o arquivo antes de investigar assunto relacionado:"
  printf '%s\n' "${files[@]}" | sort -r | head -n 15 | while IFS= read -r f; do
    title=$(grep -m1 '^# ' "$f" | cut -c3-); echo "- ${f##*/} — ${title:-(sem título)}"
  done
done
