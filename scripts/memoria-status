#!/usr/bin/env bash
# Lista os registros de memória com idade em dias, para a limpeza do /fechar.
# Fontes: docs/memoria/ do repo atual e ~/.tailor-ia-lean/memoria/<pasta>/ (fallback sem git).
set -uo pipefail
now=$(date +%s)
for dir in "$(git rev-parse --show-toplevel 2>/dev/null)/docs/memoria" "$HOME/.tailor-ia-lean/memoria/$(basename "$PWD")"; do
  [ -d "$dir" ] || continue
  echo "## $dir"
  for f in "$dir"/*.md; do
    [ -e "$f" ] || { echo "(vazio)"; break; }
    # Data do último commit que tocou o arquivo; clone/pull iguala o mtime. Sem git: stat (GNU primeiro, BSD depois).
    mtime=$(git -C "$(dirname "$f")" log -1 --format=%ct -- "$f" 2>/dev/null)
    [ -n "$mtime" ] || mtime=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f")
    age=$(( (now - mtime) / 86400 ))
    title=$(grep -m1 '^# ' "$f" | cut -c3-)
    printf '%4dd  %s — %s\n' "$age" "${f##*/}" "${title:-(sem título)}"
  done | sort -rn
done
